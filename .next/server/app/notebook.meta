{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/notebook/layout,_N_T_/(app)/notebook/page,_N_T_/notebook"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/notebook/__PAGE__",
    "/!KGFwcCk/notebook",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}